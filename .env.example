# OctoSQL Database Server Configuration
OCTOSQL_PORT=8421
OCTOSQL_HOST=0.0.0.0

# Master cryptographic secret for AES-256-GCM data encryption at rest
OCTOSQL_MASTER_KEY=OctoSQL-Production-Secure-Database-Key-Change-In-Prod

# Security: Comma-separated list of allowed system IPs for OctoAdminer and management APIs
OCTOSQL_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1,localhost

# Internal API Daemon Token
OCTOSQL_API_TOKEN=octosql-secret-daemon-token

# Redis Cache Integration (Optional - Falls back to high-speed in-memory store)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379